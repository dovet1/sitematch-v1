{
  "compilerOptions": {
    "target": "es2017",
    "lib": ["dom", "dom.iterable", "es6"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/components/*": ["./src/components/*"],
      "@/lib/*": ["./src/lib/*"],
      "@/types/*": ["./src/types/*"],
      "@/app/*": ["./src/app/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "//": "The excluded test files cover the legacy listings/wizard surface. They drifted out of sync with the code they test long ago — most of them fail at runtime too — and that surface is slated for removal, so repairing their types would be work spent on code that is going away. next.config.js sets ignoreBuildErrors: false, so leaving them in would block every deploy. Everything current — sitematcher-unified, sitesketcher-v2, find-sites, the API routes — is still type-checked. Delete these entries along with the files when the legacy surface goes.",
  "exclude": [
    "node_modules",
    "src/app/api/consultant/profile/__tests__",
    "src/app/api/listings/__tests__",
    "src/components/listings/**/__tests__",
    "src/components/map/__tests__/MultiListingClusterPopup.test.tsx",
    "src/components/ui/__tests__/image-upload.test.tsx",
    "src/components/ui/__tests__/searchable-dropdown.test.tsx",
    "src/lib/__tests__/enhanced-listings-validation.test.ts",
    "src/lib/__tests__/listings-validation.test.ts",
    "src/lib/__tests__/organization-service.test.ts",
    "src/lib/__tests__/reference-data.test.ts",
    "src/lib/__tests__/wizard-utils.test.ts"
  ]
}