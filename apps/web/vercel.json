{
  "crons": [
    {
      "path": "/api/cron/update-saved-search-matches",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/send-saved-search-notifications",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/process-cache-rebuilds",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/send-monthly-planning-alerts",
      "schedule": "0 8 1 * *"
    },
    {
      "path": "/api/cron/snapshot-brand-stores",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/match-store-floor-areas",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/sync-plota",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/refresh-plota",
      "schedule": "0 5 * * 1"
    },
    {
      "path": "/api/cron/classify-planning",
      "schedule": "0 */6 * * *"
    }
  ],
  "functions": {
    "app/api/upload/route.ts": {
      "maxDuration": 30
    },
    "app/api/cron/update-saved-search-matches/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/send-saved-search-notifications/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/process-cache-rebuilds/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/send-monthly-planning-alerts/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/snapshot-brand-stores/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/match-store-floor-areas/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/sync-plota/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/refresh-plota/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/classify-planning/route.ts": {
      "maxDuration": 300
    }
  },
  "routes": [
    {
      "src": "/api/upload",
      "methods": ["POST"],
      "headers": {
        "Access-Control-Allow-Origin": "*"
      }
    }
  ]
}
