# Supabase Local Development
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Production (when ready)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-production-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key

# Resend Configuration (for Newsletter Subscription)
# Required for Story 2.1: Landlord Email Capture
# Get these from https://resend.com/dashboard
RESEND_API_KEY=your-resend-api-key-here
RESEND_AUDIENCE_ID=your-resend-audience-id-here

# Stripe Configuration
# Get these from https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_PRICE_ID=price_xxxxx  # Annual plan (£975/year)
STRIPE_MONTHLY_PRICE_ID=price_yyyyy  # Monthly plan (£99/month)
STRIPE_COUPON_ID=coup_xxxxx  # 50% off coupon (once) for annual
STRIPE_MONTHLY_COUPON_ID=coup_zzzzz  # 50% off for 12 months for monthly
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# PostHog Configuration
# Get these from https://app.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-project-api-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Planning intelligence (server-side only)
# Both workers are disabled until their explicit flags are true. Keep the page size at
# 10 while using a Demo Plota key; Starter permits 50.
PLOTA_API_KEY=plota_demo_xxxxx
PLOTA_SYNC_ENABLED=false
PLOTA_CENSUS_SCOPE=reduced
PLOTA_PAGE_SIZE=10
PLOTA_MAX_PAGES_PER_RUN=1

OPENROUTER_API_KEY=sk-or-v1-xxxxx
PLANNING_CLASSIFICATION_ENABLED=false
OPENROUTER_PLANNING_MODEL=google/gemini-2.5-flash-lite
PLANNING_LLM_MONTHLY_BUDGET_USD=20
PLANNING_LLM_INITIAL_BUDGET_USD=2
PLANNING_LLM_CLASSIFICATION_RESERVATION_USD=0.003

# Expensive operator research has a separate kill switch and stage ceiling. Keep disabled;
# enable only for one deliberately invoked batch, then turn it off again.
PLANNING_RESEARCH_ENABLED=false
OPENROUTER_PLANNING_RESEARCH_MODEL=openai/gpt-5.2
PLANNING_LLM_RESEARCH_BUDGET_USD=2
PLANNING_LLM_RESEARCH_RESERVATION_USD=0.1

# Do not activate the brand-only eligibility limb until the labelled set contains at
# least 200 hits and reaches 95% precision.
PLANNING_BRAND_LIMB_ENABLED=false

# Switches the existing Planning tab from its legacy upstream lookup to the stored Plota
# census. Enable only after the 12-month baseline and coverage checks are complete.
PLANNING_STORED_READ_ENABLED=false
